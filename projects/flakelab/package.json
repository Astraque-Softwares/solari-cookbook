{
  "name": "flakelab",
  "version": "0.1.0",
  "description": "Find, reproduce, and prove fixes for flaky Playwright tests.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kelvinguchu/solari-cookbook.git",
    "directory": "projects/flakelab"
  },
  "homepage": "https://github.com/kelvinguchu/solari-cookbook/tree/main/projects/flakelab",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.6.0",
  "bin": {
    "flakelab": "./bin/flakelab.mjs"
  },
  "exports": {
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "ci:select": "tsx src/ci/select-command.ts",
    "ci:summary": "tsx src/ci/summary-command.ts",
    "flakelab": "tsx src/cli.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "prepack": "pnpm build",
    "test": "playwright test --pass-with-no-tests",
    "test:headed": "playwright test --headed",
    "typecheck": "tsc --noEmit",
    "quality": "pnpm typecheck && pnpm lint && pnpm test",
    "verify:solari-parallel": "tsx src/verify-solari-parallel.ts",
    "verify:solari": "tsx src/verify-solari.ts",
    "verify:bisect": "tsx src/verify-bisect.ts"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.35",
    "@solarisdk/browser": "^0.1.2",
    "@solarisdk/sandbox": "^0.1.2",
    "ai": "^7.0.87",
    "diff": "^9.0.0",
    "dotenv": "^17.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "undici": "^7.29.0",
    "vite": "^8.2.2",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0 <2"
  },
  "devDependencies": {
    "@hono/eslint-config": "^2.1.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  }
}
